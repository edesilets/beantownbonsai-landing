---
const today = new Date();
---

<footer>
	<div class="social-links">
		<a href="https://www.instagram.com/beantown.bonsai" target="_blank">Instagram</a>
	</div>
	&copy; {today.getFullYear()} Beantown Bonsai. All rights reserved.
</footer>
<style>
	footer {
		padding: 2em 1em 6em 1em;
		color: rgb(var(--color-white));
		text-align: center;
	}
	.social-links {
		display: flex;
		justify-content: center;
		gap: 1em;
		margin-top: 1em;
	}
	.social-links a {
		text-decoration: none;
		color: rgb(var(--color-white));
	}
	.social-links a:hover {
		color: rgb(var(--color-yellow-50));
	}
</style>
