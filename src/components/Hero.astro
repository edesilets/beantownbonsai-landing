---
---

<div class="m-hero" id="m-home">
  <div class="m-hero-bg">
    <div class="m-hero-img">
      <svg width="40" height="40" viewBox="0 0 48 48" fill="none">
        <rect x="20" y="28" width="8" height="12" rx="1" fill="rgba(122,158,110,0.2)"/>
        <ellipse cx="24" cy="22" rx="14" ry="12" fill="rgba(122,158,110,0.15)"/>
        <ellipse cx="16" cy="18" rx="8" ry="7" fill="rgba(122,158,110,0.12)"/>
        <ellipse cx="32" cy="18" rx="8" ry="7" fill="rgba(122,158,110,0.12)"/>
      </svg>
      <span style="font-family:monospace;font-size:9px;letter-spacing:0.12em;text-transform:uppercase;color:rgba(122,158,110,0.3)">hero photo</span>
    </div>
    <!-- Decorative circles -->
    <svg style="position:absolute;top:50%;left:50%;transform:translate(-50%,-50%);width:260px;height:260px;opacity:0.12" viewBox="0 0 260 260" fill="none">
      <circle cx="130" cy="130" r="120" stroke="rgba(122,158,110,0.8)" stroke-width="1"/>
      <circle cx="130" cy="130" r="80"  stroke="rgba(122,158,110,0.6)" stroke-width="1"/>
      <circle cx="130" cy="130" r="40"  stroke="rgba(122,158,110,0.4)" stroke-width="1"/>
    </svg>
  </div>
  <div class="m-hero-content">
    <p class="m-eyebrow m-hero-eyebrow">Boston's Living Art Gallery</p>
    <h1 class="m-hero-title">Ancient<br/><em>art,</em><br/>living trees.</h1>
    <p class="m-hero-sub">Handcrafted bonsai and rare botanicals — each specimen a decade in the making.</p>
    <button class="m-btn-primary" data-scroll-to="shop">
      Explore Collection
      <svg width="12" height="9" viewBox="0 0 14 10" fill="none">
        <path d="M1 5h12M9 1l4 4-4 4" stroke="currentColor" stroke-width="1.5" stroke-linecap="round" stroke-linejoin="round"/>
      </svg>
    </button>
  </div>
</div>
