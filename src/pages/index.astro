---
import BaseHead from "../components/BaseHead.astro";
import Header from "../components/Header.astro";
import Footer from "../components/Footer.astro";
import { Image } from "astro:assets";
import companyLogo from "../../public/BeantownBonsai-Graphic.png"; 
import { SITE_TITLE, SITE_DESCRIPTION } from "../consts";
---

<!doctype html>
<html lang="en">
	<head>
		<BaseHead title={SITE_TITLE} description={SITE_DESCRIPTION} />
	</head>
	<body>
		<!-- <Header /> -->
		<main
			class="flex flex-col items-center justify-center min-h-screen px-6 py-10 text-center"
		>
			<!-- Logo -->
			<div class="w-half max-w-xs sm:max-w-sm md:max-w-md mb-6">
				<Image
					src={companyLogo}
					alt="Beantown Bonsai LLC Logo"
					class="w-full h-auto"
				/>
			</div>

			<!-- Heading -->
			<h1
				class="text-3xl sm:text-4xl font-bold mb-4 tracking-wide"
			>Contact Us</h1>

			<!-- Email -->
			<a
				href="mailto:connect@beantownbonsai.com"
				class="text-lg sm:text-xl hover:text-orange-400 transition-colors duration-200 mb-8 block"
			>
				connect@beantownbonsai.com
			</a>

			<!-- Services List -->
			<ul class="list-none space-y-1 text-lg sm:text-xl">
				<li>Beautiful Bonasi for sale</li>
			</ul>
		</main>
		<!-- <Footer /> -->
	</body>
</html>
